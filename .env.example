# Copy to .env and fill in real values. Never commit .env itself.

DB_USER=postgres
DB_PASSWORD=changeme
DB_NAME=chatdb
DB_HOST=localhost
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/chatdb
REDIS_URL=redis://localhost:6379/0

# Groq (LlmService requires this — raises ValueError at startup if unset)
GROC_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google (Gemini, used by ChatGoogleGenerativeAI)
GOOGLE_API_KEY=your-google-api-key
