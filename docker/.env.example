# Copy to docker/.env and fill in real values. Never commit docker/.env itself.
#
# Differs from ../.env because it's consumed inside the container:
# - DATABASE_URL points at the compose 'db' service, not localhost
# - REDIS_URL reaches the host's local redis via host.docker.internal
# - EVIDENTRACE_DEV_ENGINE_URL reaches the compute engine running on the host

DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=chatdb
DB_HOST=db
DB_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/chatdb
REDIS_URL=redis://host.docker.internal:6379/0
EVIDENTRACE_DEV_ENGINE_URL=http://host.docker.internal:8100

# Groq (LlmService requires this — raises ValueError at startup if unset)
GROC_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Google (Gemini, used by ChatGoogleGenerativeAI)
GOOGLE_API_KEY=your-google-api-key
